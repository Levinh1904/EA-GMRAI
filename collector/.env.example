# GMRAI Collector — copy to collector/.env on the Windows machine.
# KHÔNG bao giờ commit file .env thật; mật khẩu MT5/FTMO chỉ nhập trên máy chạy collector.

# --- MT5 (tùy chọn: để trống => đăng nhập thủ công trên MT5 Terminal) ---
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=FTMO-Server4
MT5_SYMBOL=XAUUSD

# --- Ingestion API ---
GMRAI_INGEST_URL=https://your-server.example.com
GMRAI_API_KEY=change-me
GMRAI_COLLECTOR_ID=windows-pc-01

# --- Sync ---
GMRAI_SYNC_INTERVAL_SECONDS=60
GMRAI_RESYNC_BARS=50
GMRAI_MAX_BATCH=5000
MT5_HISTORY_DAYS=365

# --- Runtime ---
GMRAI_CHECKPOINT_DIR=./checkpoints
GMRAI_LOG_DIR=./logs
GMRAI_LOG_LEVEL=INFO
