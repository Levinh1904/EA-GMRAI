# GMRAI Backend — environment template (copy to backend/.env)
# Không commit .env thật; mọi secret phải đổi ở production.

# --- Core ---
GMRAI_DATABASE_URL=sqlite:///./gmrai.db
GMRAI_ARTIFACT_DIR=./artifacts
GMRAI_AUTO_CREATE_TABLES=true
GMRAI_AUTO_MIGRATE=false

# --- Security ---
# Production: secret ngẫu nhiên >= 32 bytes (openssl rand -hex 32)
GMRAI_SECRET_KEY=dev-secret-change-me-in-production
GMRAI_ACCESS_TOKEN_EXPIRE_MINUTES=720
# API key fallback cho ingestion (hash được seed vào bảng api_keys khi start)
GMRAI_API_KEY=dev-ingest-key-change-me
GMRAI_ADMIN_USERNAME=admin
GMRAI_ADMIN_PASSWORD=admin-change-me

# --- CORS ---
GMRAI_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Data freshness (phút) ---
GMRAI_MAX_AGE_M5_MINUTES=30
GMRAI_MAX_AGE_M15_MINUTES=60
GMRAI_MAX_AGE_H1_MINUTES=240

# --- Automation ---
GMRAI_AUTOMATION_ENABLED=true
GMRAI_SYNC_CHECK_INTERVAL_SECONDS=300
GMRAI_RETRAIN_CHECK_INTERVAL_SECONDS=600
GMRAI_MIN_NEW_CANDLES_FOR_RETRAIN=200

# --- Model defaults ---
GMRAI_HMM_N_STATES=5
GMRAI_HMM_N_INIT=10
GMRAI_HMM_SEED=42
GMRAI_TRAIN_FRACTION=0.70
GMRAI_VAL_FRACTION=0.15
GMRAI_RF_HORIZON=12
GMRAI_RF_UP_THRESHOLD_ATR=0.75
GMRAI_APPROVE_MIN_F1=0.55
GMRAI_APPROVE_MAX_FALSE_TREND_RATE=0.25
