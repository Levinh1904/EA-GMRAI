# GMRAI — root environment template (copy to .env cho docker-compose)
# KHÔNG commit .env thật. Production: đổi mọi giá trị dưới đây.

# --- PostgreSQL ---
POSTGRES_USER=gmrai
POSTGRES_PASSWORD=gmrai-change-me
POSTGRES_DB=gmrai

# --- Backend security (production: openssl rand -hex 32) ---
GMRAI_SECRET_KEY=dev-secret-change-me-in-production
GMRAI_ADMIN_USERNAME=admin
GMRAI_ADMIN_PASSWORD=admin-change-me
# API key cho collector ingestion (hash được seed vào bảng api_keys)
GMRAI_API_KEY=dev-ingest-key-change-me
GMRAI_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Automation ---
GMRAI_AUTOMATION_ENABLED=true
GMRAI_SYNC_CHECK_INTERVAL_SECONDS=300
GMRAI_RETRAIN_CHECK_INTERVAL_SECONDS=600
GMRAI_MIN_NEW_CANDLES_FOR_RETRAIN=200

# --- Model gate ---
GMRAI_APPROVE_MIN_F1=0.55
GMRAI_APPROVE_MAX_FALSE_TREND_RATE=0.25

# --- Frontend ---
# Dùng "" (rỗng) khi frontend gọi qua nginx cùng domain; hoặc URL đầy đủ khi dev
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Ports ---
HTTP_PORT=80
HTTPS_PORT=443
